<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
      <PackageReference Include="NUnit" Version="4.6.1" />
      <PackageReference Include="NUnit3TestAdapter" Version="6.3.0">
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DataTable\DataTable.csproj" />
      <ProjectReference Include="..\DataTable.Importer\DataTable.Importer.csproj" />
      <ProjectReference Include="..\DataTable.Tests.Generator\DataTable.Tests.Generator.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
      <None Update="TestData\table.db" CopyToOutputDirectory="PreserveNewest" />
      <None Include="..\DataTable.Importer\Input\*.xlsx"
            Link="ImporterInput\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
